<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Demo.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Demo.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Demo.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Demo.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Demo.SectionBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Demo.Footer" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="ShapeAppearance.Demo.Card" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Demo.PresentationChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textAppearance">@style/TextAppearance.Demo.Badge</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
